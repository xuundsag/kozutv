# kozuTV V5.4.19 — environment
# Everything here is optional except what the feature needs: with no .env the app
# still boots, streams and browses; accounts are what depends on these.

PORT=3000

# ---------------------------------------------------------------- accounts
# Sign in with Discord, watchlists and per-episode reactions all live in
# Postgres. Without a connection string the app runs signed-out: the header shows
# Sign in, and pressing it explains that the server has no account database.
# Either name works; DATABASE_URL_POOLED is preferred when the provider offers a
# pooled (PgBouncer) endpoint, which is what a serverless deploy wants.
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=verify-full
# DATABASE_URL_POOLED=postgresql://user:password@pooled-host:6543/db?sslmode=verify-full

# From https://discord.com/developers/applications — an app with the `identify`
# scope only; no bot, no server, no privileged intents.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be listed verbatim in the Discord app's OAuth2 redirect list, and must be
# the address visitors actually use. A mismatch is the classic cause of a sign-in
# that returns to the site with no profile: the token exchange is rejected.
DISCORD_REDIRECT_URI=https://your-domain.example/api/auth/discord/callback
# Signs the short-lived OAuth state. Any long random string; leave it unset and
# the client secret is used. Set it if you run more than one instance.
# AUTH_STATE_SECRET=
# Set to 1 when the site is served over https so the session cookie is marked
# Secure. Leave unset on a plain http preview.
# KOZUTV_SECURE_COOKIES=1

# ------------------------------------------------------------ legacy cache
# Optional MongoDB token store for the media providers. If unset, a file cache is
# used instead (data/remote-cache.json).
MONGODB_URI=
MONGODB_DB=kozutv
MONGODB_COLLECTION=cache_token_store
NVIDIA_API_KEY=

# Optional Discord presence webhook. Never hard-code a private webhook in source.
DISCORD_WEBHOOK_URL=
# Required for signed media links to work across multiple serverless instances.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_PROXY_SECRET=
