{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{data/**,public/**,riva/**}",
      "excludeFiles": "{.arena/**,google_drive/**,scripts/**,shots-5419/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
